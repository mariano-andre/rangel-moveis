{
  "tasks": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "deno run -A --env-file=.env src/db/seed.ts",
    "db:backup": "deno run -A --env-file=.env scripts/backup.ts"
  },
  "imports": {
    "@/": "./src/",
    "@types/better-sqlite3": "npm:@types/better-sqlite3@^9.6.0",
    "better-sqlite3": "npm:better-sqlite3@^13.0.3",
    "drizzle-kit": "npm:drizzle-kit@^0.31.10",
    "drizzle-orm": "npm:drizzle-orm@^0.45.2",
    "lucide-react": "npm:lucide-react@^0.474.0",
    "next": "npm:next@16.2.9",
    "react": "npm:react@19.2.4",
    "react-dom": "npm:react-dom@19.2.4",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.3.3",
    "@types/node": "npm:@types/node@^26.1.2",
    "@types/react": "npm:@types/react@^19.2.18",
    "@types/react-dom": "npm:@types/react-dom@^19.2.4",
    "babel-plugin-react-compiler": "npm:babel-plugin-react-compiler@1.0.0",
    "eslint": "npm:eslint@^9",
    "eslint-config-next": "npm:eslint-config-next@16.2.9",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "typescript": "npm:typescript@^5",
    "zod": "npm:zod@^4.4.3"
  },
  "nodeModulesDir": "auto",
  "allowScripts": [
    "npm:sharp@0.34.5",
    "npm:unrs-resolver@1.12.2"
  ],
  "exclude": [
    "test/"
  ]
}
